# Tick configuration

# PostgreSQL connection string (required)
NUXT_DATABASE_URL=postgresql://tick:password@localhost:5432/tick

# Session encryption secret, 32+ random chars (required)
# Generate with: openssl rand -base64 36
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-32-chars-min

# Apply pending SQL migrations on production startup (default: true).
# Set to 'false' if you run migrations out-of-band (drizzle-kit migrate).
# NUXT_AUTO_MIGRATE=true

# SMTP for outgoing email — invite emails + password-reset links (optional).
# When unset, Tick still works: invites show a copyable link instead of
# emailing, and password-reset links are printed to the server console
# (watch your logs / `docker compose logs app`) so self-hosters without
# SMTP can still recover accounts.
# NUXT_SMTP_HOST=smtp.example.com
# NUXT_SMTP_PORT=587
# NUXT_SMTP_USER=tick@example.com
# Single-quote secrets containing `$` — Compose expands it otherwise: 'pa$$word'
# NUXT_SMTP_PASS=app-password
# 'true' = implicit TLS (usually port 465); leave unset/false for STARTTLS on 587
# NUXT_SMTP_SECURE=false
# NUXT_MAIL_FROM="Tick <tick@example.com>"

# Bind host/port for the production node server (defaults: 0.0.0.0 / 3000)
# NITRO_HOST=0.0.0.0
# NITRO_PORT=3000

# Self-serve registration mode (default: open, matching existing deploys).
#   open   — anyone reaching the host can create their own workspace
#   invite — signup requires a valid invite link (recommended for teams)
#   closed — no self-serve signup at all
# NUXT_PUBLIC_REGISTRATION=invite

# Auth rate limit: max POSTs per IP per auth endpoint (login/register/forgot/
# reset) per minute. Default 10; set 0 to disable (e.g. when the reverse
# proxy already rate-limits). Single-node in-memory window — multi-node
# deploys should rate-limit at the proxy.
# NUXT_AUTH_RATE_LIMIT=10

# Session cookie Secure flag (default: true). Browsers only store a Secure cookie
# over https:// or a loopback address (http://localhost, 127.x) — on plain http://<LAN-IP> sign-in "succeeds"
# but you stay logged out. Set false ONLY when users reach Tick over plain http://
# on a network you fully trust: the session cookie (and passwords) then cross the
# network in cleartext. Behind a TLS reverse proxy keep it true.
# Use true or false (1/0 also work). Empty or unrecognized values stop Tick at startup.
# NUXT_SESSION_COOKIE_SECURE=false

# Reverse-proxy note: terminate TLS at the proxy and add
# Strict-Transport-Security there; the app itself sends CSP, X-Frame-Options,
# nosniff and Referrer-Policy on every response. Keep NUXT_SESSION_COOKIE_SECURE
# at its default.

# Demo mode (default: off). NUXT_DEMO_MODE=true resets the demo org's data
# every 24h (checked hourly, marker in .data/) and blocks destructive
# operations: password change, org rename, member removal, invite
# create/revoke, CSV import commit (preview still works) and permanent
# trash deletion. NUXT_PUBLIC_DEMO_MODE=true shows the
# "Demo — data resets nightly" banner in the app shell.
# NUXT_DEMO_MODE=true
# NUXT_PUBLIC_DEMO_MODE=true

# docker-compose only: password for the bundled Postgres service (default: tick)
# POSTGRES_PASSWORD=tick
# docker-compose only: host port the app is published on (default: 3000)
# TICK_PORT=3000
# docker-compose only: host IP the app port binds to (default: 0.0.0.0 = all
# interfaces). Use 127.0.0.1 behind a reverse proxy on the same host — Docker
# bypasses ufw/firewalld, so 0.0.0.0 is reachable even if the firewall blocks it.
# TICK_IP=0.0.0.0
# (plain http:// from another machine also needs NUXT_SESSION_COOKIE_SECURE=false, above)
