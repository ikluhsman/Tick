# Tick configuration
# PostgreSQL connection string
NUXT_DATABASE_URL=postgresql://tick:password@localhost:5432/tick
# Session encryption secret, 32+ random chars (openssl rand -base64 36)
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-32-chars-min
# Bind host/port for production (node server)
# NITRO_HOST=0.0.0.0
# NITRO_PORT=3000
